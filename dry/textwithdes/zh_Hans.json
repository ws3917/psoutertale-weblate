    "317bbb9a63a0c292d19e45e4a0cd2a9a": "[img]res://Sprites/Menus/Menu Sprites/StatArrowUp.tres[/img] [color=orange]生命回复[/color]",
    "a8974e11baed90f3f508ae55eb20247b": "一件贴有醒目反光条的背心，\n能让人注意到你的存在。",
    "75ac3b03133b70ed97de5bf963c869aa": "一块口感酥脆、美味可口的石头，入口即爆。绝对可以刺激到任何人的味蕾。回复100HP。",
    "2211c41686c5a7352204dc526e82e81a": "说服",
    "5a053f921ed8c26173e7c843c95d9a43": "[img=13]res://Sprites/Menus/Menu Sprites/KanakoIcon.tres[/img] \n防守",
    "f729b32477151203b612c054a05e920b": "护目镜能保护你的双眼\n不受强光的伤害。",
    "aedf0f13494f59ec82ca9cfb8671b8d6": "一根法杖，\n末端点缀了一只狐狸头饰。",
    "dfa13c849acfbcfc2d9a14ce378a19a8": "一条熟悉，却又透露出一种诡异不同的项链。恍如魔法。",
    "3514656db22170546a3702e526a219af": "一个金色的小圆铃铛，\n摇晃时会发出清脆的叮当声。",
    "d0c80f52f3620babd6aff191a4102824": "金色的\n小圆铃铛。",
    "0dd007124d3377cc1f1f7e7c868b1ca0": "保护\n眼睛。",
    "e71c974939e9cd4b203206de6fada036": "||我认得这个。||",
    "7e03f382012acf856faa87d760ee1552": "|||这让我想起了Kanako...|",
    "398ffdb12ef96df58f98c04b230a4d59": "||||...很可爱，是吧？",
    "f4107ab0786cf8d0d1d8d0eae8ae98df": "|这光亮真好！|||",
    "5743de6972694334a4157c6aa3b46f7e": "||我已经很亮了。||",
    "35b7b4a1d1196feec697104cc77444d1": "|||跟我衣服不怎么搭呢...|",
    "813bab850214d78336418e295ae32eda": "||||你看我像工人吗？！",
    "e032bf48a97290d0923054381676be81": "|有点看不清了...|||",
    "c78b46c1d81343af4e28cd2852d0f11c": "|||好像装不进去...|",
    "f0422ebb42f1a63594bc173bdb017529": "||||我难道要...？！",
    "c73237717b7b30d1bdea3598c70b1828": "|这条项链...|||",
    "d2f2e82fa712ed9e4443f641bbdbbfce": "||我认得这个！||",
    "acd9e80f85f18e10005e348160493619": "|||...|",
    "2af69be6e638cf203e7a6d6926e43fe1": "||||哇哦，这玩意一看就值不少钱。",
    "4626abc2e07f3b04b34bee5c950c28e2": "|这让我想起了妈妈...|||",
    "df55e1488ceb092c38b2dcbde9eb0704": "||我认得这个！！！||",
    "05cc43ce3a1bd195017e59c002e5f707": "|||我觉得它更适合Kanako。|",
    "31b6835e29ae38b37fa029c330150e79": "||||挺漂亮，但我不爱。",
    "ff331491f52958891fd36a9cc98f4b99": "|哇哦，好大...|||",
    "bb997cdddd4da6e5750170dff7b06b94": "||吓到我了。||",
    "bcc8ca96c76603170e8aca983685275f": "|||呃...|",
    "26ebc18cd066e274c1d13de4de80777f": "从Axis升级后的机体上\n取来的一只手。耐用抗造。",
    "8b1c3e02e8de7b157a39716190d8e94e": "||||喂，搞啥？",
    "15ddf6706dcde71c264e4d4d9461f2a9": "一款蒸汽动力的护手装置，不适配有机生物。把它交给机器。",
    "d4516452bf148d586ef10602faf39538": "|呃，压根戴不上啊...|||",
    "46378603660fc0d504f22e449ef8e900": "||标准款。||",
    "16e849b132fb536fe46e28fc93ba62cd": "|||...穿不上啊...|",
    "4a0f637443ef288bee4d15d158d7ee8d": "||||哎呀，都穿烂了。",
    "1c835cdcc45a0ce35b0034e62ae1f5ed": "|啊，那只手...|||",
    "a63ae4332af8c4828d7ad09b3da18f0b": "||缺少另一只。||",
    "83570545b98378c9ee911a0fb39250e4": "|||像个垫子...|",
    "41a2bf3c5c0be3d1dfcdd468cc1b36b9": "||||当枕头挺不错。",
    "c64fe30dca8b6d183cf5c8303873c5a8": "||崭新的部件。||",
    "840bd7d7aa1022b44622d2597f7bade1": "|||提升不多，但够用。|",
    "9be9ade2ecf06577a8a5d281ed57a76c": "||||这什么破玩意？",
    "a007ba6935eb710d98c380f6623ee6c5": "||那场戏烂透了。||",
    "47d6060da1aab6ae67d8aa320bf21911": "|||这不是动画片里的吗？|",
    "a72713b459f9bf85dfe778ca84f98326": "||||我又不是小孩！",
    "c8e4394508fa6398a0350c4eea94aee5": "|这不好吗，Cole？|||",
    "702bfbb233311c5cd45fe25245137739": "||出乎意料的兼容-||",
    "d30dc3877e116b004eb83235d2538600": "|||啊，谢谢。|",
    "a37c28c0635d81460d98a80da93166c2": "||||算了，就这样吧。",
    "705dc5a81829a536a4f1857c31947474": "|（为啥他这么开心...？）|||",
    "f291535bd56a01be254748a29a1826d8": "|哕！这啥啊？！|||",
    "f90d3e162350de24e4edb7ff29b93ded": "|||你-你确定能吃？|",
    "f34109a9b71c3e1871a85eb94748ad71": "||||你不会想毒死我吧？！",
    "cd8465f66be6ec629a2d922a47d4d64e": "||那是KANAKO小姐的。||",
    "21b99ca8b5bd18a3af4d2f19decc2315": "|（这是？）||好重啊...|",
    "a666e1c7114cb27d8e344f8276180937": "||||呃，不要...？！",
    "bd61f4290fdac7100311c5b835c0f35c": "||你以为我想要这块【破烂】吗？！||",
    "ff77d2356998f7ac0ef7d4649da223c8": "|||我对枪不太感兴趣...|",
    "5229e0666aec5d6bdd6093c9be11d77e": "||||跟我不搭。",
    "a09207f17520a6b337aefd4d0b2c7715": "一支激光步枪，颇具未来感。",
    "eb58be5693da2dfc6c6d281141981629": "|这也太酷了！|||",
    "3247c5df5dda2c3726ea9eabff4a02c1": "||我对那个没兴趣。||",
    "416312ac48d4bc3afe1757ba1fa02b89": "|||看起来好危险...|",
    "ef45662315b3258de7f334cd633101e7": "一顿可供全员食用的丰盛午餐。\n为全员回复150HP。",
    "8146d954b27f9dfe59197e4a5e175f46": "一把自家种植的健康枪械。\n可以发射豌豆。",
    "c91126ff724ac3d25be6230d6d46b01f": "|...这是蔬菜？|||",
    "59eeb72b0a285628b08eca97c0a36716": "||一棵【字面意思的】豌豆射手！？||",
    "71dd3c8dfaadcab21f45b11fc3d2e21a": "|||至少是纯天然的...？|",
    "1e0f8cb98e525a94cdf2fe7e68276402": "||||咦——，不要！",
    "5e283d30b793c0efeab2f40a03262bbe": "|||那是Kanako的...|",
    "b6db46606e13f3e9af35525b53d503bd": "||||不感兴趣。",
    "7e8b76c5b54e5ed20ed8e712c5482376": "快到獏尔玛购买东西吧！",
    "6e1efd0424e11644526e9c539cf33524": "来自Kanako：Cole！",
    "f579d82006a7539106faa0a11d40dee9": "来自Virgil：伙伴...",
    "be37093bf575e6c0e76c9dc81c8d982b": "||...这是火药。||,",
    "603727a0e2c8ccb804566eac8205e56c": "|...“棍子”...？，谢谢，不要。||",
    "cd191b7d23d5cc0941047c9f27b9ac3e": "一把巨大螺丝刀，使用起来就像棍棒一样。威力十足！",
    "528da70e15b9a00026173677b8f6d4c8": "黑暗世界的众多通缉犯的画像。\n点击[color=yellow]使用[/color]即可查看。",
    "db7150d6aa6021e21daeda29b2326461": "一枚即使身处黑暗之中，\n仍可闪耀光芒的勋章。",
    "39f4e5372ed6cd92117c4ee10ab1b3d7": "一只巨型金属手，侧面装有火箭装置。威力十足。",
    "e65d394d3c33279163a4610ba369db5d": "||有我的双眼就够了。||",
    "5d4f9c418bbcf553b161c0e8d0abf77b": "|看起来... 很脆？|||",
    "3ca1493ec3a6645645e0067946bd802a": "||||那不就是个玩具吗？！",
    "74956d07b3032175ca6dd2741a09d80e": "|哇，太好吃了...|给你9分，因为我还想再吃1点。|哇... 谢谢...|天，肚子要撑炸了！",
    "836cd78aedb2c294f5533c910c3b119f": "|||...我都拿不起来...|",
    "6fbc6ec67ffc1bb0ade8dccb2682b2e8": "||||头正好伸进去！",
    "9f4166554dc728401f22fe87215a5be7": "|嘿，我做的更好！|||",
    "5145e0e705864b8293448ec60863c3f1": "|呕，薄荷糖...||（怪不得她不喜欢这个...）|",
    "87319a324c3ce3deb18c9ef9218f2651": "||这玩意是怎么运作的？||",
    "6eadbd54236b2c8350c3c440b8595a07": "|||真提神...|",
    "d8f862bee8103d9d0870780b11c4c75d": "||||提神。",
    "92cc832ed229b14c182afafd15349679": "|有点熟悉...|||",
    "27bc7ea6c57d5a1519c9a2dd63c74caa": "|哇，好重...|||",
    "2c0474bd7af8fa35ddfbaf106d47b332": "||不错的升级。||",
